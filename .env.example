# ---------------------------------------------------------------------------
# monitoring-smokeping
#
# V Portaineru se tyhle proměnné zadávají v sekci "Environment variables"
# u stacku. Lokálně zkopíruj do .env, který je v .gitignore.
#
# POZOR: dosazují se při BUILDU (build args v docker-compose.yml), ne za běhu.
# Změna kterékoli z nich vyžaduje redeploy stacku, ne jen restart kontejneru.
# ---------------------------------------------------------------------------

# Identita měřicího bodu. Skončí jako label `host` na všech sériích a odliší
# měření z různých vantage pointů. Na každém dalším hostu nasadíš ten samý
# stack a změníš jen tuhle hodnotu.
HOSTNAME=supermicro-proxmox

# Remote write endpoint centrálního Prometheusu (přes Caddy).
# Cesta /api/v1/write je povinná.
CENTRAL_PROMETHEUS_URL=https://prometheus.example.com/api/v1/write

# Basic auth pro remote write. Nechat prázdné, pokud jedeš uvnitř VPC.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
